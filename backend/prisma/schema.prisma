// AutoHub Prisma Schema
// Database schema for the AutoHub platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User Model
// ============================================

enum UserRole {
  user
  business
  admin
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  firstName     String?  @map("first_name")
  lastName      String?  @map("last_name")
  phone         String?
  role          UserRole @default(user)
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  services  Service[]
  reviews   Review[]
  favorites Favorite[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// ============================================
// City Model
// ============================================

model City {
  id         Int       @id @default(autoincrement())
  name       String
  slug       String    @unique
  region     String?
  population Int?
  createdAt  DateTime  @default(now()) @map("created_at")

  // Relations
  services Service[]

  @@index([slug])
  @@map("cities")
}

// ============================================
// Service Category Model
// ============================================

model ServiceCategory {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  prices ServicePrice[]

  @@map("service_categories")
}

// ============================================
// Service (Автосервис) Model
// ============================================

enum ServiceStatus {
  pending
  approved
  rejected
  inactive
}

enum ServicePlan {
  free
  basic
  premium
}

model Service {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  name              String
  description       String?       @db.Text
  cityId            Int           @map("city_id")
  address           String
  latitude          Decimal?      @db.Decimal(10, 8)
  longitude         Decimal?      @db.Decimal(11, 8)
  phone             String
  email             String?
  website           String?
  workingHours      Json          @map("working_hours")
  rating            Decimal       @default(0.00) @db.Decimal(3, 2)
  reviewsCount      Int           @default(0) @map("reviews_count")
  status            ServiceStatus @default(pending)
  moderationComment String?       @db.Text @map("moderation_comment")
  plan              ServicePlan   @default(free)
  planExpiresAt     DateTime?     @map("plan_expires_at")
  viewsCount        Int           @default(0) @map("views_count")
  phoneClicksCount  Int           @default(0) @map("phone_clicks_count")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relations
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      City           @relation(fields: [cityId], references: [id])
  photos    ServicePhoto[]
  prices    ServicePrice[]
  reviews   Review[]
  favorites Favorite[]
  payments  Payment[]

  @@index([cityId])
  @@index([status])
  @@index([rating(sort: Desc)])
  @@index([plan])
  @@map("services")
}

// ============================================
// Service Photo Model
// ============================================

model ServicePhoto {
  id         String   @id @default(uuid())
  serviceId  String   @map("service_id")
  url        String
  isPrimary  Boolean  @default(false) @map("is_primary")
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_photos")
}

// ============================================
// Service Price Model
// ============================================

model ServicePrice {
  id         String   @id @default(uuid())
  serviceId  String   @map("service_id")
  categoryId Int      @map("category_id")
  name       String
  priceFrom  Decimal? @db.Decimal(10, 2) @map("price_from")
  priceTo    Decimal? @db.Decimal(10, 2) @map("price_to")
  duration   String?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id])

  @@index([serviceId])
  @@map("service_prices")
}

// ============================================
// Review Model
// ============================================

enum ReviewStatus {
  pending
  approved
  rejected
}

model Review {
  id                String       @id @default(uuid())
  userId            String       @map("user_id")
  serviceId         String       @map("service_id")
  rating            Int
  title             String?
  text              String       @db.Text
  pros              String?      @db.Text
  cons              String?      @db.Text
  status            ReviewStatus @default(pending)
  moderationComment String?      @db.Text @map("moderation_comment")
  response          String?      @db.Text
  responseAt        DateTime?    @map("response_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  // Relations
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  photos  ReviewPhoto[]

  @@unique([userId, serviceId])
  @@index([serviceId])
  @@index([userId])
  @@index([status])
  @@index([rating])
  @@map("reviews")
}

// ============================================
// Review Photo Model
// ============================================

model ReviewPhoto {
  id        String   @id @default(uuid())
  reviewId  String   @map("review_id")
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_photos")
}

// ============================================
// Favorite Model
// ============================================

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  serviceId String   @map("service_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@map("favorites")
}

// ============================================
// Payment Model
// ============================================

enum PaymentStatus {
  pending
  completed
  failed
}

model Payment {
  id            String        @id @default(uuid())
  serviceId     String        @map("service_id")
  plan          ServicePlan
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(pending)
  paymentMethod String?       @map("payment_method")
  transactionId String?       @map("transaction_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  completedAt   DateTime?     @map("completed_at")

  // Relations
  service Service @relation(fields: [serviceId], references: [id])

  @@map("payments")
}
