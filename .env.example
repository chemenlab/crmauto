# ============================================
# AUTOHUB ENVIRONMENT VARIABLES
# ============================================

# Database
DATABASE_URL="postgresql://autohub_user:autohub_password@localhost:5432/autohub"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# API
API_PORT=4000
API_URL="http://localhost:4000"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# External Services
# Yandex Maps
NEXT_PUBLIC_YANDEX_MAPS_API_KEY="your-yandex-maps-api-key"

# SMS.ru
SMS_RU_API_KEY="your-sms-ru-api-key"

# SendPulse
SENDPULSE_API_ID="your-sendpulse-api-id"
SENDPULSE_API_SECRET="your-sendpulse-api-secret"

# Analytics
NEXT_PUBLIC_YANDEX_METRIKA_ID="12345678"
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# Sentry
SENTRY_DSN="your-sentry-dsn"
NEXT_PUBLIC_SENTRY_DSN="your-sentry-dsn"

# App Settings
NODE_ENV="development"
PORT=3000

# File Upload
MAX_FILE_SIZE=5242880  # 5MB in bytes
UPLOAD_DIR="./uploads"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000  # 1 minute
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_SECRET="your-session-secret-change-this"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Cloudflare (Production)
# CLOUDFLARE_API_KEY="your-cloudflare-api-key"
# CLOUDFLARE_ZONE_ID="your-zone-id"
